<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder and must not be compiled into the API -->
    <Compile Remove="EnergyApi.Tests\**" />
    <Content Remove="EnergyApi.Tests\**" />
    <EmbeddedResource Remove="EnergyApi.Tests\**" />
    <None Remove="EnergyApi.Tests\**" />
  </ItemGroup>

</Project>